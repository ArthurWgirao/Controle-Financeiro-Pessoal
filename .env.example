# Ambiente: development, testing ou production
APP_ENV=development

# Gere uma chave local com:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=substitua-por-uma-chave-segura

# Sem DATABASE_URL, a aplicação continua usando SQLite.
# Para selecionar PostgreSQL explicitamente, use uma URL postgresql+psycopg://.
DATABASE_URL=

# Caminho do arquivo SQLite usado quando DATABASE_URL estiver vazio
DATABASE_PATH=finance.db

# Copie estes exemplos para .env.postgres.local, que não é versionado.
POSTGRES_DB=controle_financeiro
POSTGRES_USER=controle_financeiro_app
POSTGRES_PASSWORD=gere-uma-senha-local-forte
POSTGRES_PORT=5432
POSTGRES_TEST_DATABASE_PREFIX=controle_financeiro_test_
