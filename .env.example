# Ambiente da aplicação: development, testing ou production
APP_ENV=development

# Gere uma chave exclusiva e segura para cada ambiente
SECRET_KEY=substitua-por-uma-chave-aleatoria-segura

# PostgreSQL é o banco principal. Use somente credenciais próprias do ambiente.
DATABASE_URL=postgresql+psycopg://controle_financeiro_app:senha-ficticia@127.0.0.1:5432/controle_financeiro

# Variáveis consumidas pelo PostgreSQL do Docker Compose
POSTGRES_DB=controle_financeiro
POSTGRES_USER=controle_financeiro_app
POSTGRES_PASSWORD=substitua-por-uma-senha-local-forte
POSTGRES_PORT=5432

# Infraestrutura protegida dos testes PostgreSQL
POSTGRES_TEST_ADMIN_URL=postgresql+psycopg://controle_financeiro_app:senha-ficticia@127.0.0.1:5432/postgres

# Destino exclusivo e vazio usado pela ferramenta de transferência
POSTGRES_TRANSFER_DATABASE_URL=postgresql+psycopg://controle_financeiro_app:senha-ficticia@127.0.0.1:5432/controle_financeiro_destino

# Fallback SQLite controlado, usado somente quando DATABASE_URL estiver ausente
DATABASE_PATH=finance.db

# Em produção, configure APP_ENV, SECRET_KEY e DATABASE_URL no ambiente de deploy.
