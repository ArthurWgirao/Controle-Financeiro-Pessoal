# Ambiente: development, testing ou production
APP_ENV=development

# Gere uma chave local com:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=substitua-por-uma-chave-segura

# Por enquanto, configure DATABASE_URL ou DATABASE_PATH.
DATABASE_URL=

# Caminho do arquivo SQLite usado quando DATABASE_URL estiver vazio
DATABASE_PATH=finance.db
